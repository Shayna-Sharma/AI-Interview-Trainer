# Copy this file to .env and fill in your real IBM Cloud API key.
# NEVER commit .env to version control.
#
# HOW TO GET YOUR IBM CLOUD API KEY:
#   1. Sign in at https://cloud.ibm.com
#   2. Go to Manage → Access (IAM) → API Keys  (or visit https://cloud.ibm.com/iam/apikeys)
#   3. Click "Create an IBM Cloud API key"
#   4. Copy the key and paste it below.
#
# WITHOUT A REAL KEY the backend returns:
#   "IBM_API_KEY is not configured."  (HTTP 400)

IBM_API_KEY=your_real_ibm_cloud_api_key_here

# Optional overrides — these match the values already embedded in config.py
# and only need to be set if you change the IBM deployment or model.
# FLASK_DEBUG=true
# FLASK_HOST=0.0.0.0
# FLASK_PORT=5000
# DATABASE_PATH=interview_trainer.db
# IBM_SPACE_ID=7beb0e73-5a95-48e0-af3e-39389481163b
# IBM_MODEL_ID=ibm/granite-4-h-small
